{
  "name": "stego-pwa",
  "version": "1.0.0",
  "description": "Offline PWA that hides password-encrypted messages inside PNG images via LSB steganography.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:share": "tsc --noEmit && vite build --config vite.config.share.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun run test/engine.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
